# Inactive cutover template for the existing public gateway.
# Prerequisite: attach that gateway to the external
# bimspect_marketing_proxy Docker network. Do not enable before the staging DNS
# record exists and Cloudflare SSL mode is Full (strict). The current gateway
# already defines Docker's 127.0.0.11 resolver at the http level.

upstream marketing_nextjs_staging {
    zone marketing_nextjs_staging 64k;
    server marketing-web:3000 resolve;
}

server {
    listen 80;
    server_name web-staging.bimspect.com;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name web-staging.bimspect.com;

    ssl_certificate     /etc/nginx/certs/bimspect-origin.crt;
    ssl_certificate_key /etc/nginx/certs/bimspect-origin.key;

    location ~ /\.(?!well-known/) {
        return 404;
    }

    location / {
        proxy_pass http://marketing_nextjs_staging;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
        proxy_redirect off;
    }
}
