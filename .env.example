# PRODUCTION loopback-only host ports used by docker-compose.yml.
# Explicit local Compose uses fixed ports 3000 and 127.0.0.1:8081 instead.
MARKETING_PORT=3001
NGINX_TEST_PORT=8081

# Optional public setting. Empty uses the source default in lib/launch.ts.
# Because this is compiled into browser code, rebuild after changing it.
NEXT_PUBLIC_LAUNCH_AT=

# Campaign lead proxy. Keep all values except the Turnstile site key server-only.
BIMSPECT_CRM_URL=https://crm.bimspect.com
BIMSPECT_CRM_API_SECRET=
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Online payments. Mock is the safe payment provider default until BIMSpect
# has approved Revolut Merchant credentials and implemented the adapter
# described in docs/revolut-payment-integration.md. Do not expose any payment
# secret with a NEXT_PUBLIC_ prefix.
PAYMENT_PROVIDER=mock

# Online checkout is disabled by default, including when the provider is mock.
# For local mock testing only, set CHECKOUT_ENABLED=true.
# Before Revolut is ready in production, keep CHECKOUT_ENABLED=false.
# For future Revolut checkout, set PAYMENT_PROVIDER=revolut and
# CHECKOUT_ENABLED=true after configuring the server-only values below.
CHECKOUT_ENABLED=false

# Future Revolut Merchant configuration (server-only)
REVOLUT_MERCHANT_SECRET_KEY=
REVOLUT_WEBHOOK_SECRET=
REVOLUT_MERCHANT_API_VERSION=
