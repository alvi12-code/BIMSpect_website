# Local-only host ports. Change only after checking that the replacement is free.
MARKETING_PORT=3001
NGINX_TEST_PORT=8081

# Optional public setting. Empty uses the source default in lib/launch.ts.
# Because this is compiled into browser code, rebuild after changing it.
NEXT_PUBLIC_LAUNCH_AT=

# Campaign lead proxy. Keep all values except the Turnstile site key server-only.
BIMSPECT_CRM_URL=https://crm.bimspect.com
BIMSPECT_CRM_API_SECRET=
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
