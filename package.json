{
  "name": "bimspect-website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "docker:local:up": "bash scripts/docker-local.sh up",
    "docker:local:down": "bash scripts/docker-local.sh down",
    "docker:local:stop": "bash scripts/docker-local.sh stop",
    "docker:local:build": "bash scripts/docker-local.sh build",
    "docker:local:logs": "bash scripts/docker-local.sh logs",
    "docker:local:ps": "bash scripts/docker-local.sh ps",
    "docker:local:config": "bash scripts/docker-local.sh config",
    "docker:production:check": "bash scripts/check-production-compose.sh"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.1",
    "gsap": "3.15.0",
    "next": "16.3.1",
    "react": "latest",
    "react-dom": "latest",
    "three": "0.186.1"
  },
  "overrides": {
    "@eslint/eslintrc": {
      "js-yaml": "4.3.1"
    },
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.18"
    },
    "minimatch@10.2.5": {
      "brace-expansion": "5.0.9"
    },
    "nanoid": "^3.3.18",
    "postcss": "^8.5.26",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/three": "0.186.0",
    "eslint": "latest",
    "eslint-config-next": "16.3.1",
    "typescript": "latest"
  }
}
